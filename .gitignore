# Extracted host tooling (apk-tools from the SDK) — reproducible, never committed
.feed-tools/
# Generated feed trees, if someone points one here
feed-tree/
# Signing material — a PRIVATE key must never reach the repo. feed-keygen.sh
# writes <name>.sec (EC) next to the public key it is safe to publish.
*.sec
*.key
# Rehearsal TLS material generated by tests/feed-https-server.py
.tls/
# Python bytecode from the test harness
__pycache__/

# The feed's PUBLIC keys ARE part of the published tree and must be committed
# with it (records/tree/keys/). Some machines' global gitignore ignores *.pem;
# a repo-level rule has higher precedence, so negate it here. Private material
# (*.sec, *.key) stays ignored above.
!records/tree/keys/*.pem
